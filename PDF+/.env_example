# Django
SECRET_KEY=
# true лише локально. На проді не задавати.
DEBUG=false
# Через кому. На проді: ALLOWED_HOSTS=pdf-share.website
ALLOWED_HOSTS=localhost,127.0.0.1
# Через кому, зі схемою. На проді: CSRF_TRUSTED_ORIGINS=https://pdf-share.website
# Локально порожньо.
CSRF_TRUSTED_ORIGINS=
# HSTS (діє лише при DEBUG=false). Спершу 3600; 31536000 — коли HTTPS перевірено.
SECURE_HSTS_SECONDS=3600

# PostgreSQL
# У Docker PG_HOST/PG_PORT перекриває compose.yaml (db:5432), а PG_DB/USER/PASSWORD
# задають і саму базу в контейнері db при першому старті.
PG_DB=man_pdf_share
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

# Docker (лише прод). compose читає їх через symlink: ln -s PDF+/.env .env
# Токен конектора Cloudflare Tunnel (Zero Trust → Networks → Tunnels → тунель → Install connector).
# Домен pdf-share.website і маршрут на http://web:8000 задаються там же, у Public hostname.
CLOUDFLARE_TUNNEL_TOKEN=
# Кількість воркерів gunicorn; за замовчуванням 3 (з Dockerfile).
# WEB_CONCURRENCY=3

# Redis (кеш Django: лічильники throttle входу в API).
# Порожньо = LocMemCache, локально так і лишати. У Docker REDIS_URL задає compose.yaml.
# Локально з Redis: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# OAuth (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Client ID застосунків iOS/Android через кому (вхід через Google у мобільному API)
GOOGLE_MOBILE_CLIENT_IDS=

ADMIN_SITE_URL=

# Cloudflare R2 (S3-сумісне сховище для PDF)
# USE_R2=false — файли лежать у PDF+/media, як раніше.
# У Docker — лише true: медіа-volume нема, файли зникали б з кожним деплоєм.
USE_R2=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_URL_EXPIRE=3600

# Sentry (баг-трекер). Порожній DSN = вимкнено, локально так і лишати.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Хеш коміту для групування помилок за релізом; на проді: git rev-parse HEAD.
SENTRY_RELEASE=
# Частка запитів для performance-трейсів. Не піднімати до 1.0 — спалить квоту.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Пошта (SMTP) — для листів скидання пароля.
# Порожній SMTP_HOST = листи друкуються в консоль runserver, локально так і лишати.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=PDF+ <noreply@pdf-share.website>
