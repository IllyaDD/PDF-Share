# Django
SECRET_KEY=
# true лише локально. На проді не задавати.
DEBUG=false
# Через кому. На проді — домен сайту, локально localhost,127.0.0.1.
ALLOWED_HOSTS=localhost,127.0.0.1
# Через кому, зі схемою: https://example.com. Локально порожньо.
CSRF_TRUSTED_ORIGINS=
# HSTS (діє лише при DEBUG=false). Спершу 3600; 31536000 — коли HTTPS перевірено.
SECURE_HSTS_SECONDS=3600

# PostgreSQL
PG_DB=man_pdf_share
PG_USER=postgres
PG_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

ADMIN_SITE_URL=

# Cloudflare R2 (S3-сумісне сховище для PDF)
# USE_R2=false — файли лежать у PDF+/media, як раніше.
USE_R2=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_URL_EXPIRE=3600

# Sentry (баг-трекер). Порожній DSN = вимкнено, локально так і лишати.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Хеш коміту для групування помилок за релізом; на проді: git rev-parse HEAD.
SENTRY_RELEASE=
# Частка запитів для performance-трейсів. Не піднімати до 1.0 — спалить квоту.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Пошта (SMTP) — для листів скидання пароля.
# Порожній SMTP_HOST = листи друкуються в консоль runserver, локально так і лишати.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=PDF+ <noreply@example.com>
